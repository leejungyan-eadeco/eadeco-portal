# Portal's own database (pnpm db:up)
DATABASE_URL=postgres://postgres:eadepro@localhost:23021/eadepro_portal

# ---- NAV 2018 web services (reads dropdown lists and creates draft invoices) ----

# Server instance base URL, without /ODataV4 or /WS at the end.
# Example: http://navserver:7048/DynamicsNAV110
NAV_BASE_URL=

# How the portal signs in to NAV:
#   current  = the Windows account the portal runs as (Kerberos, no password stored here). Recommended on the domain.
#   windows  = the domain account below (NAV_DOMAIN / NAV_USERNAME / NAV_PASSWORD).
#   navuser  = a NAV user password (only if the NAV server uses NavUserPassword).
NAV_AUTH=current

# Only used when NAV_AUTH=current or navuser.
NAV_DOMAIN=

# The account needs to create sales and purchase invoices; posting rights are not needed.
NAV_USERNAME=
NAV_PASSWORD=

# ---- Login with Active Directory (eadeco.local) ----

# Domain controllers to check passwords against (LDAPS), tried in order.
AD_URLS=ldaps://adsvr4.eadeco.local:636,ldaps://svrad1.eadeco.local:636
AD_DOMAIN=EADECO
AD_BASE_DN=DC=eadeco,DC=local
# Who may sign in is managed in the portal (Settings > Users). These usernames are always admins,
# so there is a way in even when the list is empty. Comma-separated AD usernames.
BOOTSTRAP_ADMINS=

# Signs the 1-day login token. Keep secret; changing it signs everyone out.
SESSION_SECRET=
# true when the portal is served over HTTPS (cookie only sent over HTTPS).
COOKIE_SECURE=false

# ---- Parking reports ----

# Encrypts the parking portal passwords that users save with their setups. 32 random bytes, base64:
#   openssl rand -base64 32
# Keep it secret and backed up: if it changes, saved passwords must be typed in again.
CREDENTIALS_KEY=
# Where report files, screenshots and recordings are stored (screenshots/recordings kept 30 days). Back this folder up.
STORAGE_DIR=storage
# Optional: moved into the first setup on start if it has no account yet; also used by pnpm test:e2e.
CARPARK_PORTAL_USERNAME=
CARPARK_PORTAL_PASSWORD=

# Development only (pnpm dev): act as this portal user without a password, e.g. off the office network.
# Ignored in production. The user must be active in Settings > Users.
DEV_SKIP_LOGIN=
